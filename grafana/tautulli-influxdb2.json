{
  "uid": "tautulli-exporter-influxdb2",
  "title": "Tautulli Exporter (InfluxDB 2.x)",
  "description": "Sample dashboard for TautulliExporter (https://github.com/clara-j/TautulliExporter), InfluxDB 2.x queries. Pick a Flux data source and set Bucket to the exporter's INFLUXDB_BUCKET. The Users row needs PER_USER_METRICS=true.",
  "tags": [
    "tautulli",
    "plex"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "influxdb",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "textbox",
        "name": "bucket",
        "label": "Bucket",
        "query": "tautulli",
        "current": {
          "text": "tautulli",
          "value": "tautulli"
        },
        "hide": 0,
        "description": "The exporter's INFLUXDB_BUCKET"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Streams",
      "id": 2,
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"get_activity\" and (r._field == \"stream_count\"))\n  |> group()\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"stream_count\"}))",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
