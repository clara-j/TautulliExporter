{
  "uid": "tautulli-exporter",
  "title": "Tautulli Exporter (VictoriaMetrics)",
  "description": "Sample dashboard for TautulliExporter (https://github.com/clara-j/TautulliExporter), VictoriaMetrics queries. Set the db field to the exporter's INFLUXDB_DATABASE. The Users row needs PER_USER_METRICS=true.",
  "tags": [
    "tautulli",
    "plex"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "textbox",
        "name": "db",
        "label": "db label",
        "query": "tautulli",
        "current": {
          "text": "tautulli",
          "value": "tautulli"
        },
        "hide": 0,
        "description": "The exporter's INFLUXDB_DATABASE, which VictoriaMetrics stores as the db label"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Streams",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
